    - target: {fileID: 5007852625696663409, guid: eab7afaae38f4274bb6d600ea3ca60a5, type: 3}
      propertyPath: m_Text
      value: "\u0414\u043E\u0431\u0430\u0432\u0438\u0442\u044C \u0432\u043E\u043B\u043D\u0443
        \u0437\u0430 50 \u043C\u043E\u043D\u0435\u0442"
      objectReference: {fileID: 0}
    - target: {fileID: 5007852625696663409, guid: eab7afaae38f4274bb6d600ea3ca60a5, type: 3}
      propertyPath: m_FontData.m_FontSize
      value: 32
      objectReference: {fileID: 0}
    - target: {fileID: 5391287430346508007, guid: eab7afaae38f4274bb6d600ea3ca60a5, type: 3}
      propertyPath: m_Text
      value: "\u042D\u0442\u043E \u0430\u043B\u0442\u0430\u0440\u044C \u043C\u0430\u043D\u0438\u043F\u0443\u043B\u044F\u0446\u0438\u0439
        \u0441 \u0432\u0440\u0430\u0436\u0435\u0441\u043A\u0438\u043C\u0438 \u0432\u043E\u043B\u043D\u0430\u043C\u0438\r\n\r\n\u0424\u0443\u043D\u043A\u0446\u0438\u044F:
        \u041F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442 \u0443\u043F\u0440\u0430\u0432\u043B\u044F\u0442\u044C
        \u0432\u043E\u043B\u043D\u0430\u043C\u0438 \u0430\u0442\u0430\u043A\u0438
        \u0432\u0440\u0430\u0433\u043E\u0432. \u041A\u043E\u0433\u0434\u0430 \u0442\u044B
        \u043E\u0442\u043E\u0431\u044C\u0435\u0448\u044C \u0432\u0441\u0435 \u0432\u043E\u043B\u043D\u044B,
        \u043E\u0442\u043A\u0440\u043E\u0435\u0442\u0441\u044F \u043F\u043E\u0440\u0442\u0430\u043B
        \u043D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u0443\u0440\u043E\u0432\u0435\u043D\u044C.\r\n\r\n\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0435:
        \u041A\u043E\u0433\u0434\u0430 \u0431\u0443\u0434\u0435\u0448\u044C \u0433\u043E\u0442\u043E\u0432
        \u043A \u0432\u0440\u0430\u0436\u0435\u0441\u043A\u043E\u0439 \u0430\u0442\u0430\u043A\u0435
        \u043D\u0430\u0436\u043C\u0438 \u043D\u0430 \u043A\u043D\u043E\u043F\u043A\u0443
        \u043D\u0430\u0447\u0430\u0442\u044C \u0432\u043E\u043B\u043D\u0443. \u041D\u043E
        \u0431\u0443\u0434\u044C \u0432\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u0435\u043D,
        \u0435\u0441\u043B\u0438 \u0442\u0432\u043E\u0435\u0433\u043E \u0433\u0435\u0440\u043E\u044F
        \u0443\u0431\u044C\u044E\u0442 \u0438\u043B\u0438 \u0432\u0440\u0430\u0433\u0438
        \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0430\u0442 \u0442\u0432\u043E\u0439
        \u0437\u0430\u043C\u043E\u043A, \u0438\u0433\u0440\u0430 \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u0442\u0441\u044F
        ! "
      objectReference: {fileID: 0}
